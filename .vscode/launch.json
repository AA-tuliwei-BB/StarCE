{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C++ Launch",
            "type": "cppdbg",
            "request": "launch",
            // "program": "${workspaceRoot}/build/starce",
            "program": "${workspaceRoot}/experiment/running_space/starce",
            // "cwd": "${workspaceRoot}/build",
            "cwd": "${workspaceRoot}/experiment/running_space",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
        }
    ]
}